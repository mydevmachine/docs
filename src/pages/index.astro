---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import AppShot from '../components/AppShot.astro'
import ShotViewer from '../components/ShotViewer.astro'
import { shotExists } from '../lib/app-shots'
const base = import.meta.env.BASE_URL

const principles = [
  {
    title: 'Open source CLI',
    body: 'The CLI and every package are open source. Read them, fork them, change them.',
  },
  {
    title: 'No lock-in',
    body: 'Underneath it is plain Linux, SSH and git. Stop using devmachine and your server still works.',
  },
  {
    title: 'Extensible via packages',
    body: 'Add a tool with one package, or write your own.',
    href: `${base}concepts/packages/`,
  },
  {
    title: 'Your machines, your data',
    body: 'A VPS you rent, a computer you already have, or a virtual machine on your own. Up to you.',
  },
]

const steps = [
  {
    icon: 'server',
    title: 'Your machines',
    body: 'One or more: a VPS you rent, an old laptop, or a virtual machine on your Mac. devmachine sets them up and locks them down.',
  },
  {
    icon: 'workspaces',
    title: 'Workspaces',
    body: 'Isolate one project or many. Each can have its own tech stack, logins and AI subscription.',
  },
  {
    icon: 'laptop',
    title: 'You and your agents',
    body: 'Work from your terminal, a tablet over SSH, Claude Code on your phone, or our Mac app. Build from anywhere.',
  },
]

const benefits = [
  { title: 'One workspace per project', body: "Projects never see each other's files or tokens." },
  { title: 'Work from any computer', body: 'Your code lives on your computers. No lock-in.' },
  { title: 'Agents ready to work', body: 'Claude Code, Codex and your skills in every workspace.' },
  { title: 'Flexible at the core', body: 'Install from existing packages or create your own. Keep it private or share it.' },
  { title: 'Put your site online', body: 'Your app at app.example.com, with HTTPS, in one command. No server setup.' },
  { title: 'Locked down from the start', body: 'No passwords, and no workspace runs as root. Safety first.' },
  { title: 'Move to another machine', body: 'Your whole setup is saved and versioned. Point it at a new machine and sync.' },
  { title: 'Build by day, run agents 24/7', body: 'Use it for daily work, or keep agents running around the clock. Full control.' },
  { title: 'Private until you publish', body: 'Reach apps through a tunnel or Tailscale. Only what you publish is public.' },
]

const tiers = [
  { label: 'A few apps', ram: '8 GB RAM', cpu: '2 vCPU', disk: '100 GB disk', body: 'One or two apps and a coding agent.' },
  { label: 'Recommended', ram: '16 GB RAM', cpu: '4 vCPU', disk: '200 GB disk', body: 'Several apps and coding agents at once.' },
  { label: 'Full development', ram: '32 GB RAM', cpu: '8 vCPU', disk: '400 GB disk', body: 'Docker and many intensive apps running together.' },
]
const recommendedTier = 1

const installLines = [
  { cmd: 'curl -fsSL https://mydevmachine.sh/install.sh | sh', comment: '' },
  { cmd: 'devmachine setup', comment: '# connect your server' },
  { cmd: 'devmachine skills add', comment: '# interact from any LLM session with your machine(s)' },
]

const appDmg = 'https://github.com/mydevmachine/app-releases/releases/latest/download/Devmachine.dmg'
const macStrip = [
  {
    name: '18-operator',
    alt: 'The Operator session under Local, with Claude Code open in ~/.config/devmachine adding the globex workspace.',
    caption: 'Operator: ask for any change.',
  },
  {
    name: '01-sessions',
    alt: 'Four sessions of the acme workspace side by side: Claude Code, Codex, tests and a dev server.',
    caption: 'Sessions side by side.',
  },
  {
    name: '19-home',
    alt: 'The home screen with three machines, main, backup and staging, each with RAM, disk, load and container counts, above the Claude Code and Codex usage cards.',
    caption: 'Every machine at a glance.',
  },
].filter(shotExists)
const macFeatures = ['Guided setup', 'Operator session', 'Sessions side by side', 'All machines at a glance']
const appSteps = [
  { title: 'Download Devmachine for Mac.', body: 'Drag it to Applications and open it.' },
  { title: 'Let it set you up.', body: 'Run each setup step in a terminal inside the app, or let Claude Code or Codex do it for you.' },
  { title: 'Open a session.', body: 'Pick a workspace in the sidebar and start working, with Claude Code, Codex or a plain terminal.' },
]

const description =
  'devmachine turns a Debian or Ubuntu server into your own coding machine, with one workspace per project. Free and open source.'
const doc = (path: string, label: string) =>
  `<a class="faq-link" href="${base}${path}">${label} →</a>`
const faq = [
  {
    q: 'Does it log in as root with a password?',
    a: `Only once. <code>setup</code> uses the root password your provider gave you to install a key that only you have, checks that the key works, and then turns password logins off. From then on the server only accepts that key. It also checks the server's fingerprint first, so you know you reached your own server.`,
    link: doc('how-it-works/trust-bootstrap/', 'How setup locks the server'),
  },
  {
    q: 'What is a workspace, and why use one?',
    a: `A workspace is one account on the server for one project, with its own tools, logins and coding agent. Projects do not see each other's files or tokens, one project breaking does not touch the others, and you open any of them by name: <code>devmachine ssh acme</code>.`,
    link: doc('concepts/machines-and-workspaces/', 'Machines and workspaces'),
  },
  {
    q: 'Is it free?',
    a: `Yes. The CLI and every package are free and open source, under the MIT licence, and the Mac app is free too. You pay only for the server you rent, or nothing if you use a computer you already have.`,
    link: `<a class="faq-link" href="https://github.com/mydevmachine/devmachine">The code on GitHub →</a>`,
  },
  {
    q: 'Does it only work with Linux?',
    a: `The machines it sets up run Debian or Ubuntu. The CLI itself runs on your computer, macOS or Linux. Your Mac can also be a machine of its own, for the packages made for it.`,
    link: doc('how-it-works/your-computer-as-a-machine/', 'Your computer as a machine'),
  },
  {
    q: 'Does it work on Windows?',
    a: `Yes, through WSL 2. Install Ubuntu (<code>wsl --install -d Ubuntu-24.04</code>), open its terminal and install the CLI the same way as on Linux: <code>curl -fsSL https://mydevmachine.sh/install.sh | sh</code>. Every command works there: <code>setup</code>, <code>sync</code>, <code>ssh</code>, <code>run</code>, <code>upload</code> and <code>update</code>. Your configuration lives in your Linux home inside WSL. We test it on Windows with Ubuntu 24.04 under WSL 2. It does not run in PowerShell or cmd, and the desktop app is macOS only.`,
    link: doc('getting-started/', 'Getting started'),
  },
  {
    q: 'How do I configure my machine?',
    a: `Ask your coding agent. After <code>devmachine skills add</code>, any Claude Code or Codex session can add packages, workspaces and sites for you. For bigger changes, like writing your own package, open a session in the configuration folder: it holds your whole setup, and a <code>CLAUDE.md</code> there can tell the agent your own rules.`,
    link: doc('day-to-day/', 'Day to day'),
  },
  {
    q: 'Can I use my old laptop?',
    a: `Yes, if it runs Debian or Ubuntu and you can reach it as root over SSH. Set it up from your computer on the same network with <code>devmachine machines add</code>, then add the <code>tailscale</code> package and sign it in with <code>devmachine login tailscale</code>. Put <code>tailscale:&lt;name&gt;</code> first in its addresses, and you reach it from anywhere, even from outside your home.`,
    link: doc('concepts/reaching-your-server/', 'Reaching your server'),
  },
  {
    q: 'Can I use more than one machine?',
    a: `Yes. Add as many as you like with <code>devmachine machines add</code>. Each workspace belongs to one machine, so <code>devmachine ssh acme</code> finds the right one. A command that acts on a whole machine asks you to name it with <code>--machine</code>: it never guesses.`,
    link: doc('how-it-works/choosing-a-target/', 'Choosing a target'),
  },
  {
    q: 'Do I need a domain?',
    a: `No. You need one only to show an app at a public URL with HTTPS. Without one, <code>devmachine tunnel acme 3000</code> opens the app on your own computer, and nothing is published.`,
    link: doc('concepts/publishing/', 'Publishing an app'),
  },
  {
    q: 'What is Ansible?',
    a: `Ansible is a well-known open source tool that installs and configures software on a server from a written description. devmachine uses it underneath, so you never need to learn it. You write Ansible only if you write a package of your own.`,
    link: doc('concepts/packages/', 'Packages'),
  },
  {
    q: 'Where is my configuration?',
    a: `In a folder on your computer, <code>~/.config/devmachine</code>. <code>devmachine config path</code> prints where it is. It holds your machines, workspaces, packages and settings, and nothing personal ever goes into devmachine itself.`,
    link: doc('concepts/configuration/', 'Configuration'),
  },
  {
    q: 'How should I save my configuration?',
    a: `In git. <code>devmachine setup git</code> turns the folder into a repository, and every change the CLI makes becomes a commit. Push it to a private remote to keep a backup and see what changed. Private keys and secrets are never committed.`,
    link: doc('how-it-works/versioning-your-configuration/', 'Versioning your configuration'),
  },
  {
    q: 'What is Tailscale? Does it work with Headscale?',
    a: `Tailscale puts your computer and your servers on a private network of your own, so a server is reachable even when its public address is not. The <code>tailscale</code> package signs in to Tailscale's own service. With Headscale, run <code>tailscale up --login-server</code> on the machine yourself; devmachine only needs the address. Any other VPN works the same way.`,
    link: doc('concepts/reaching-your-server/', 'Reaching your server'),
  },
  {
    q: 'How can I install my agents?',
    a: `Look in the <a href="${base}packages/">official packages</a> first: Claude Code, its plugins and Remote Control are there, ready to add. For anything else, like another agent or a tool of your own, ask your coding agent to write a package for it. It can save anything in your configuration folder, and <code>devmachine sync</code> installs it like any other package.`,
    link: doc('packages/', 'Browse the packages'),
  },
  {
    q: 'How do I add more packages?',
    a: `<code>devmachine packages list</code> shows what exists. <code>devmachine packages add docker</code> adds one to a machine, <code>--workspace acme</code> adds it to a workspace, and <code>devmachine sync</code> installs it. To make your own, start with <code>devmachine packages new</code>.`,
    link: doc('concepts/packages/', 'Packages'),
  },
  {
    q: 'What happens if I stop using it?',
    a: `Your servers keep working. Underneath it is plain Linux, SSH and git: each workspace is an ordinary account you can still log in to with <code>ssh</code>, and nothing of devmachine runs on the server between commands.`,
    link: doc('concepts/machines-and-workspaces/#the-linux-account', 'The Linux account behind a workspace'),
  },
]

const site = Astro.site?.href ?? 'https://mydevmachine.sh/'
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'devmachine',
    url: site,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'devmachine',
    description,
    url: site,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux',
    license: 'https://github.com/mydevmachine/devmachine/blob/main/LICENSE',
    downloadUrl: 'https://github.com/mydevmachine/devmachine/releases',
    softwareHelp: `${site}getting-started/`,
    image: `${site}og.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: ['https://github.com/mydevmachine/devmachine'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]+>/g, '').replace(/&lt;/g, '<').replace(/&gt;/g, '>') },
    })),
  },
]
---


<BaseLayout title="devmachine - Code from anywhere." description={description} current="home" jsonLd={jsonLd}>
  <Hero
    eyebrow="Your own development shed"
    headline="Code from anywhere."
    subline="Any machine you own. An isolated workspace for every project. No lock-in. Free."
  />

  <section id="principles" aria-labelledby="principles-title" class="frame pt-4 pb-16">
    <h2 id="principles-title" class="sr-only">Principles</h2>
    <div class="grid-cards grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((item) => {
          const Tag = item.href ? 'a' : 'div'
          return (
            <Tag href={item.href} class:list={['block p-6', item.href && 'hover:bg-[var(--card)]']}>
              <h3 class="text-lg font-light tracking-tight mb-2">{item.title}</h3>
              <p class="text-sm text-[var(--muted)] leading-relaxed">{item.body}</p>
            </Tag>
          )
        })
      }
    </div>
  </section>

  <section id="get-started" class="frame pt-4 pb-20 scroll-mt-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">01 / Get started</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">Start with the app, or with the CLI.</h2>
    <p class="text-[var(--muted)] max-w-2xl mb-10">
      Pick one. The Mac app is optional: it runs the same CLI on the same configuration folder, so what you do
      in one shows up in the other. Switch any time.
    </p>

    <div class="grid-cards grid-cols-1 min-[900px]:grid-cols-2">
      <div id="path-app" class="p-5 sm:p-6 flex flex-col min-w-0">
        <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-2">Easier · macOS</p>
        <h3 class="text-2xl font-light tracking-tight mb-5">Start with the app</h3>
        <ol class="space-y-4 text-sm text-[var(--muted)] leading-relaxed mb-6">
          {
            appSteps.map((step, i) => (
              <li class="flex gap-3">
                <span class="font-mono text-xs text-[var(--ink)] pt-0.5">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="text-[var(--ink)]">{step.title}</span> {step.body}
                </span>
              </li>
            ))
          }
        </ol>
        <div class="mt-auto">
          <a
            href={appDmg}
            class="inline-block border border-[var(--ink)] px-6 py-3 text-sm font-mono uppercase tracking-wide hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors"
          >
            Download for macOS
          </a>
          <p class="text-sm mt-3">
            <a href={`${base}app/`} class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]">
              Learn before download →
            </a>
          </p>
          <p class="text-xs text-[var(--muted)] mt-3">macOS 14 Sonoma or later. Or with Homebrew:</p>
          <p class="text-xs mt-1"><code class="font-mono text-[var(--ink)] break-words">brew install --cask mydevmachine/tap/devmachine-app</code></p>
        </div>
      </div>

      <div id="path-cli" class="p-5 sm:p-6 min-w-0">
        <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-2">macOS or Linux</p>
        <h3 class="text-2xl font-light tracking-tight mb-5">Start with the CLI</h3>
        <div role="tablist" aria-label="Ways to start with the CLI" class="flex border hairline">
          <button
            role="tab"
            id="tab-yourself"
            aria-controls="panel-yourself"
            aria-selected="true"
            tabindex="0"
            class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
          >
            Yourself
          </button>
          <button
            role="tab"
            id="tab-agent"
            aria-controls="panel-agent"
            aria-selected="false"
            tabindex="-1"
            class="tab-btn flex-1 px-4 py-2 text-sm font-mono uppercase tracking-wide"
          >
            With your agent
          </button>
        </div>

        <div class="tab-panels">
          <div role="tabpanel" id="panel-yourself" aria-labelledby="tab-yourself" tabindex="0" class="pt-6">
            <p class="text-xs uppercase tracking-widest text-[var(--muted)] mb-2">From your computer, run</p>
            <div class="border hairline bg-[var(--card)] p-4 sm:p-5 relative font-mono text-sm">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <code id="install-cmd" class="min-w-0 whitespace-pre-wrap break-words leading-relaxed">{installLines.map((l) => (<span class="block">{l.cmd}{l.comment && <span class="block text-[var(--muted)]">{l.comment}</span>}</span>))}</code>
                <button
                  id="install-copy"
                  type="button"
                  aria-label="Copy the install commands"
                  class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
                >
                  Copy
                </button>
              </div>
            </div>
            <p class="text-sm mt-3 text-[var(--muted)]">
              Then make a workspace: <code class="font-mono text-[var(--ink)]">devmachine workspaces new acme && devmachine sync</code>.
              <a href={`${base}getting-started/`} class="underline underline-offset-2 hover:text-[var(--ink)]">
                Getting started →
              </a>
              <a href={`${base}guides/`} class="underline underline-offset-2 hover:text-[var(--ink)] ml-2">
                Guides →
              </a>
            </p>
            <p class="text-sm mt-2 text-[var(--muted)]">
              Or with Homebrew: <code class="font-mono text-[var(--ink)]">brew install mydevmachine/tap/devmachine</code>.
            </p>
          </div>

          <div role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" tabindex="-1" class="pt-6" data-inactive>
            <p class="text-sm text-[var(--muted)] mb-3">
              Paste this into Claude Code, Codex or Cursor. It asks what it needs and does
              the rest; you only run <code class="font-mono text-[var(--ink)]">devmachine setup</code> yourself.
            </p>
            <div class="border hairline bg-[var(--card)] p-4 sm:p-5 font-mono text-sm">
              <div class="flex flex-wrap items-center justify-between gap-4">
                <code id="agent-prompt" class="min-w-0 break-all">Set up devmachine for me: read https://mydevmachine.sh/agent-setup.md and follow it.</code>
                <button
                  id="agent-prompt-copy"
                  type="button"
                  aria-label="Copy the agent prompt"
                  class="text-xs uppercase tracking-wide px-3 py-1 border hairline shrink-0"
                >
                  Copy
                </button>
              </div>
            </div>
            <p class="text-sm mt-3">
              <a href={`${base}agent-setup/`} class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]">
                Read what it will do
              </a>
            </p>
            <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mt-3">
              For LLMs:
              <a href={`${base}llms.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms.txt</a>
              ·
              <a href={`${base}llms-full.txt`} class="underline underline-offset-2 hover:text-[var(--ink)]">llms-full.txt</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="dark-section">
    <div class="frame py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-[#9a9a9a] mb-3">02 / How it works</p>
      <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-12">Your machines. Many workspaces. Any computer.</h2>
      <ol class="how-steps">
        {
          steps.map((step) => (
            <li class="how-step">
              <span class="how-icon" aria-hidden="true">
                {step.icon === 'server' && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" /><rect x="3" y="13" width="18" height="7" /><path d="M7 7.5h.01M7 16.5h.01M11 7.5h6M11 16.5h6" /></svg>
                )}
                {step.icon === 'workspaces' && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" /><rect x="13" y="3" width="8" height="8" /><rect x="3" y="13" width="8" height="8" /><rect x="13" y="13" width="8" height="8" /></svg>
                )}
                {step.icon === 'laptop' && (
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="11" /><path d="M2 19h20M8 9l2.5 2L8 13M12.5 13H16" /></svg>
                )}
              </span>
              <h3 class="text-xl font-light tracking-tight mb-2">{step.title}</h3>
              <p class="text-sm text-[#9a9a9a] leading-relaxed">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="text-sm mt-10">
        <a href={`${base}concepts/machines-and-workspaces/`} class="underline underline-offset-2 text-[#9a9a9a] hover:text-white">
          How it works →
        </a>
      </p>
    </div>
  </section>

  <section id="what-you-get" class="frame pt-20 pb-20">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">03 / What you get</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-10">Everything a developer needs.</h2>
    <div class="grid-cards grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((b) => (
          <div class="p-6">
            <h3 class="text-lg font-light tracking-tight mb-1">{b.title}</h3>
            <p class="text-sm text-[var(--muted)] leading-relaxed">{b.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="devmachine-for-mac" class="dark-section">
    <div class="frame pt-24 pb-24">
      <p class="text-xs font-mono uppercase tracking-widest text-[#9a9a9a] mb-3">04 / macOS app</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start mb-12">
        <div>
          <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">Devmachine for Mac.</h2>
          <p class="text-[#9a9a9a] max-w-lg">
            Optional, and easier to start with. Do from one window what you would do with the CLI: set up, open
            sessions, publish sites, check your machines. It runs the same CLI underneath.
          </p>
        </div>
        <div>
          <ul class="text-sm text-[#9a9a9a] space-y-2 mb-8">
            {macFeatures.map((f) => <li>{f}</li>)}
          </ul>
          <div class="flex flex-wrap gap-3">
            <a
              href={`${base}app/`}
              class="inline-block border border-white px-8 py-3 text-sm font-mono uppercase tracking-wide hover:bg-white hover:text-black transition-colors"
            >
              See the app →
            </a>
            <a
              href={appDmg}
              class="inline-block border border-white bg-white text-black px-8 py-3 text-sm font-mono uppercase tracking-wide hover:bg-transparent hover:text-white transition-colors"
            >
              Download for macOS
            </a>
          </div>
          <p class="text-xs font-mono text-[#9a9a9a] mt-4 break-words">brew install --cask mydevmachine/tap/devmachine-app ·
            <a href="https://github.com/mydevmachine/app-releases/releases" class="underline underline-offset-2 hover:text-white">All releases →</a>
          </p>
        </div>
      </div>
      {
        macStrip.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            {macStrip.map((shot) => (
              <figure class="min-w-0">
                <AppShot shot={shot} />
                <figcaption class="text-sm text-[#9a9a9a] mt-2">{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section id="measure-your-needs" class="frame pt-20 pb-4">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">05 / Requirements</p>
