---
import BaseLayout from '../layouts/BaseLayout.astro'
import AppShot from '../components/AppShot.astro'
import ShotViewer from '../components/ShotViewer.astro'
import { shotExists, type Shot } from '../lib/app-shots'

const base = import.meta.env.BASE_URL
const dmg = 'https://github.com/mydevmachine/app-releases/releases/latest/download/Devmachine.dmg'
const brew = 'brew install --cask mydevmachine/tap/devmachine-app'

interface Section {
  id: string
  title: string
  body: string
  prompts?: string[]
  shots: Shot[]
}

const allSections: Section[] = [
  {
    id: 'setup',
    title: 'Set up from the app',
    body: 'No machine yet? The app installs the CLI, then asks if you have a server. No server? It makes a virtual machine on your Mac. You pick the packages, your first workspace and the coding agents that learn devmachine, see every command before it runs, and watch each log as it goes.',
    shots: [
      {
        name: '09-setup-packages',
        alt: 'The setup on the packages step for the machine lab: essentials, docker and other package cards, a row of coding agents (Claude Code, OpenAI Codex, Pi, Antigravity CLI, opencode, Kimi Code, Cline) with Claude Code and OpenAI Codex chosen, and beside it a summary of the answers and the devmachine commands they run.',
        caption: 'Packages, coding agents, and the commands they run.',
      },
      {
        name: '09-setup-choice',
        alt: 'The first setup step asking "Do you already have a server (VPS)?", with two cards: Yes, I have a server, or No, make a machine on this Mac.',
        caption: 'A server you have, or a machine on your Mac.',
      },
      {
        name: '09-setup-details',
        alt: 'The details step for a Lima machine named lab, located on this Mac: 4 CPUs, 8 GiB of memory and a 40 GiB disk, and a first workspace named acme.',
        caption: 'Say where it is, size it, and name your first workspace.',
      },
      {
        name: '09-setup-running',
        alt: 'The setup running: the log of installing Lima and creating lab on the left, and the list of steps on the right, with Install Lima done and Create lab in progress.',
        caption: 'Every step runs here, with its log.',
      },
      {
        name: '09-setup-ready',
        alt: 'The last setup screen, "You are all set": Devmachine is ready, with a Start using Devmachine button.',
        caption: 'Ready to use.',
      },
    ],
  },
  {
    id: 'operator',
    title: 'The Operator session',
    body: 'Under Local, the sidebar always has a session called Operator. It opens in your devmachine folder, ~/.config/devmachine, where your whole setup lives. Start Claude Code or Codex there: it reads AGENTS.md, and you ask for changes in plain words.',
    prompts: [
      'Add a workspace called globex and sync it.',
      'Add the claude-code package to acme.',
      'Publish port 3000 of acme at app.example.com.',
    ],
    shots: [
      {
        name: '18-operator',
        alt: 'The Operator session under Local, with Claude Code open in ~/.config/devmachine adding the globex workspace.',
        caption: 'Operator: a session in your devmachine folder.',
      },
    ],
  },
  {
    id: 'sessions',
    title: 'Sessions side by side',
    body: 'Open several sessions of one workspace and watch them in a grid. Sessions keep running when you quit the app, and even while it updates: remote ones on their machine, local ones on your Mac. Local or remote, every feature works the same.',
    shots: [
      {
        name: '01-sessions',
        alt: 'Four sessions of the acme workspace in a grid: Claude Code, Codex, tests and a dev server.',
        caption: 'Four sessions of acme at once.',
      },
    ],
  },
  {
    id: 'context',
    title: 'Context next to each session',
    body: 'Beside the terminal: the todo list, pull requests and links of a Claude Code, Codex or Pi session, plus its files and git status.',
    shots: [
      {
        name: '02-session-claude',
        alt: 'A Claude Code session with the context panel open, showing its todo list, pull requests and links.',
        caption: 'The todo, pull requests and links of the session.',
      },
    ],
  },
  {
    id: 'drop-files',
    title: 'Drop files onto a session',
    body: 'Drag files from Finder onto a session and they land on its machine, with the path typed at the prompt for you. Paste an image with ⌘V and it works the same way. Each file keeps its name plus the time, so nothing gets overwritten.',
    shots: [
      {
        name: '22-drop-files',
        alt: 'A file dragged over the Claude Code session of acme: the pane shows "Drop to upload to acme-devmachine", and the prompt already holds the path of an earlier upload, mockup-20260930-143012.png, inside a request to match the header.',
        caption: 'Drop a file, get its path on the machine.',
      },
    ],
  },
  {
    id: 'command-palette',
    title: '⌘K for everything',
    body: 'Press ⌘K and type a few letters. Jump to any screen, session, machine or action without leaving the keyboard.',
    shots: [
      {
        name: '21-command-palette',
        alt: 'The command palette open over the app, listing screens, sessions of acme, machines and actions that match the search.',
        caption: 'One search for screens, sessions, machines and actions.',
      },
    ],
  },
  {
    id: 'home',
    title: 'Every machine at a glance',
    body: 'The home screen shows each machine with its RAM, disk, load and containers. It refreshes in the background, so the numbers are ready when you look.',
    shots: [
      {
        name: '19-home',
        alt: 'The home screen with three machines, main, backup and staging, each with RAM, disk, load and container counts, above the Claude Code and Codex usage cards.',
        caption: 'Every machine, on one screen.',
      },
    ],
  },
  {
    id: 'network-map',
    title: 'Your network as the background',
    body: 'Pick what sits behind Home in Settings → Appearance: a photo, a gradient, or a map of your network, large behind everything or compact beside the cards. The map draws from your machines and sites, so it changes when they do.',
    shots: [
      {
        name: '185-home-network-map-large-fleet',
        alt: 'The home screen over a large, faint network map: the internet at the top, links down to five machines, laptop, lab, main, staging and homebox, grouped by place, behind the machine and usage cards and the clock.',
        caption: 'The large map, behind everything on Home.',
      },
      {
        name: '183-appearance-network-map',
        alt: 'Settings on Appearance: the Background picker with four cards, Photo, Gradient, Network map large and Network map compact, with the large map chosen, above the terminal settings.',
        caption: 'Photo, gradient, or the map.',
      },
      {
        name: '180-home-network-map',
        alt: 'The home screen with a compact network map under the clock: the internet linked to laptop, main and staging.',
        caption: 'The compact map, in the free space.',
      },
    ],
  },
  {
    id: 'stats',
    title: 'Stats per machine',
    body: 'Pick a machine to see its memory, disk, load and containers, with RAM split by workspace.',
    shots: [
      {
        name: '06-stats',
        alt: 'The stats page of the main machine: memory and disk bars, running containers and RAM by workspace.',
        caption: 'Memory, disk and containers of one machine.',
      },
    ],
  },
  {
    id: 'sites',
    title: 'Sites and DNS',
    body: 'See every site each machine publishes. Publish a port in a few clicks: pick a workspace, a name and a port. The DNS records of each provider are one tab away.',
    shots: [
      {
        name: '04-subdomains-sites',
        alt: 'The subdomains page listing three sites under example.com, with their workspace, port and status.',
        caption: 'Every published site, per machine.',
      },
      {
        name: '10-publish-port',
        alt: 'The Add subdomain dialog with the acme workspace published by main, the label acme and local port 3000.',
        caption: 'Publish a port.',
      },
      {
        name: '05-subdomains-dns-cloudflare',
        alt: 'The Cloudflare tab of the subdomains page listing DNS records for example.com.',
        caption: 'DNS records, per provider.',
      },
    ],
  },
  {
    id: 'machines',
    title: 'Machines on a map',
    body: 'Settings → Machines draws your network: the internet, the machine that runs Caddy and the subdomains it serves, ssh from this Mac, tailnet links, and the workspaces on each machine. Machines in one place share a zone. Pick one to check it, sync it, see its addresses and credentials, or change where it is. A Lima machine on your Mac starts, stops and goes away from here too. Add machine asks where the new one lives.',
    shots: [
      {
        name: '161-machines-map-selected',
        alt: 'Settings on Machines: an isometric map with the internet at the top, sites such as app.acme.example.com routed through main, ssh from the laptop, a tailnet link, and five machines grouped as local, hostinger and home. Below it, main is selected with its address, location, workspaces, subdomains and packages, and Check, Sync and Full sync buttons.',
        caption: 'Every machine, where it lives and how it connects.',
      },
      {
        name: '162-machines-check',
        alt: 'The main machine card with devmachine doctor --machine main open: ssh and ansible pass, and one package waits for a sync.',
        caption: 'Check one machine.',
      },
      {
        name: '169-add-machine-location',
        alt: 'The Add a machine page on its details step for lab2, a Lima machine, with a "Where is it?" field set to local and choices Local, Hostinger, Home, Office and Other cloud, beside the commands it will run.',
        caption: 'A new machine says where it lives.',
      },
    ],
  },
  {
    id: 'workspaces',
    title: 'Workspaces by machine',
    body: 'Every workspace, grouped by the machine it lives on, each with an on/off switch. Turn one off and it leaves the sidebar, and the app stops reaching it; its sessions keep running. Make a new workspace or edit one without leaving Settings. Edit holds its settings and logins; its packages live in Packages.',
    shots: [
      {
        name: '130-workspaces-list',
        alt: 'Settings on Workspaces: acme, globex and initech under main and umbrella under staging, each with a switch, its packages, a status such as Applied or Waiting for sync, and Edit, Forget and Destroy.',
        caption: 'Grouped by machine, each one on or off.',
      },
      {
        name: '131-workspaces-new',
        alt: 'Workspaces › New workspace inside Settings: the name beta, the machine main, and package cards for the foundation, coding agents and developer tools.',
        caption: 'A new workspace, inside Settings.',
      },
      {
        name: '137-workspaces-edit',
        alt: 'Workspaces › Edit acme: zsh plugins and theme, a claude-code setting, a custom setting and the claude and glab logins, with a link to its packages.',
        caption: 'Edit its settings and logins.',
      },
    ],
  },
  {
    id: 'packages',
    title: 'Packages, many places at once',
    body: 'Browse the catalog, your own local packages, or what is installed. Narrow it down by machine and workspace. Click a row to choose where it goes, or tick several and install or remove them on many places in one go; each machine syncs in the corner. New package opens a local session with a coding agent to write one, and each local package opens its folder in one click.',
    shots: [
      {
        name: '101-packages-selected',
        alt: 'Settings on Packages: Machine and Workspace menus, Catalog, Local and Installed tabs, and a list of packages such as caddy, docker, nodejs and postgres with where each is installed. postgres is open with main chosen, and nodejs and postgres are ticked, with Install and Remove for both at the bottom.',
        caption: 'Pick where, then install or remove.',
      },
      {
        name: '102-packages-confirm',
        alt: 'A dialog asking "Install these packages?": postgres on main, with what is left out and why.',
        caption: 'It says what it will do first.',
      },
      {
        name: '104-packages-running',
        alt: 'The Packages list with postgres and tailscale pending install on main and redis pending removal, while a Sync main card in the corner shows its log.',
        caption: 'The sync runs in the corner.',
      },
    ],
  },
  {
    id: 'session-defaults',
    title: 'Session defaults',
    body: 'Choose what a new session opens, per workspace: a plain terminal, a coding agent (Claude Code, Codex, Pi, Antigravity CLI, opencode, Kimi Code or Cline), or a command of your own.',
    shots: [
      {
        name: '08-session-defaults',
        alt: 'Settings, a page beside the sidebar, on Harnesses: seven coding agents to turn on, and session defaults where acme opens Claude Code, globex runs npm run dev and initech opens OpenAI Codex.',
        caption: 'Terminal, a coding agent or your own command.',
      },
    ],
  },
  {
    id: 'health',
    title: 'Health check',
    body: 'The same checks as devmachine doctor, for every machine, one click away in Settings → Health check.',
    shots: [
      {
        name: '07-settings-health',
        alt: 'Settings, a page beside the sidebar, on Health check: the checks for main and backup, every one passing but a certificate renewal warning.',
        caption: 'devmachine doctor, in the app.',
      },
    ],
  },
  {
    id: 'cli-updates',
    title: 'CLI updates in the corner',
    body: 'When a newer devmachine CLI is out, a card in the corner says so, under the app\'s own. Update installs it, Later hides it until the next one, and Details opens Settings → About. Your machines and configuration stay as they are.',
    shots: [
      {
        name: '65-cli-update-toast',
        alt: 'Two cards in the corner: Devmachine 0.1.7 is available, with Update and Relaunch, and devmachine CLI 0.8.0 is available, with Details, Later and Update.',
        caption: 'A card for the app, and one for the CLI.',
      },
      {
        name: '60-cli-update-available',
        alt: 'Settings on About: devmachine CLI 0.8.0 is available, you have 0.7.23, with an Update CLI button and the brew upgrade devmachine command to copy.',
        caption: 'Details: the version and the command.',
      },
    ],
  },
  {
    id: 'menu-bar',
    title: 'Pull requests and usage in the menu bar',
    body: 'Your open pull requests and their checks, read through the GitHub CLI. Claude Code and Codex usage, read without spending a token.',
    shots: [
      {
        name: '03-pull-requests',
        alt: 'The menu bar window listing four pull requests with their check status.',
        caption: 'Open pull requests and their checks.',
      },
      {
        name: '20-menubar-usage',
        alt: 'The menu bar window with Claude Code and Codex usage cards.',
        caption: 'Claude Code and Codex usage.',
      },
    ],
  },
]

const sections = allSections.map((section) => ({ ...section, shots: section.shots.filter(shotExists) }))
const heroShot: Shot = {
  name: '01-sessions',
  alt: 'Four sessions of the acme workspace in a grid: Claude Code, Codex, tests and a dev server.',
}

const features = [
  { title: 'Setup, guided', body: 'A server or a machine on your Mac, set up in the app with every log shown.' },
  { title: 'Operator', body: 'A session in your devmachine folder, always one click away.' },
  { title: 'Sessions that stay', body: 'Quit or update the app: every session, local or remote, keeps running.' },
  { title: 'Grids', body: 'Several sessions of one workspace, side by side.' },
  { title: '⌘K', body: 'Jump to any screen, session, machine or action.' },
  { title: 'A context panel', body: 'Todo, pull requests, links, files and git of each session.' },
  { title: 'Home, stats and health', body: 'RAM, disk, load, containers and a health check of every machine.' },
  { title: 'A network map', body: 'Your machines by place, with their sites, links and workspaces.' },
  { title: 'Map as wallpaper', body: 'A photo, a gradient or your network behind Home.' },
  { title: 'Packages', body: 'Install or remove on many machines and workspaces at once.' },
  { title: 'Workspaces', body: 'Grouped by machine, each one on or off with a switch.' },
  { title: 'Sites and DNS', body: 'Publish a port in a few clicks. See the records of each provider.' },
  { title: 'Session defaults', body: 'Terminal, a coding agent or your own command, per workspace.' },
  { title: 'Menu bar', body: 'Pull requests, and Claude Code and Codex usage.' },
  { title: 'Drop or paste files', body: 'Drag files or paste an image into a session. They land on its machine, path typed in.' },
  { title: 'A files view', body: 'Browse and preview the files of a workspace without a session.' },
  { title: 'CLI updates', body: 'A card in the corner when a new CLI is out.' },
  { title: 'Lima, from the app', body: 'Start, stop or delete a machine on your Mac.' },
]

const cliEquivalents = [
  { what: 'Publish a port', cmd: 'devmachine expose add acme 3000 --host app.example.com', href: `${base}reference/commands/#expose` },
  { what: 'Add a package', cmd: 'devmachine packages add claude-code --workspace acme', href: `${base}reference/commands/#packages` },
  { what: 'Send a file to a workspace', cmd: 'devmachine upload mockup.png --workspace acme', href: `${base}reference/commands/#upload` },
  { what: 'See machine stats', cmd: 'devmachine stats', href: `${base}reference/commands/#stats` },
  { what: 'Run the health check', cmd: 'devmachine doctor', href: `${base}reference/commands/#doctor` },
  { what: 'Check one machine', cmd: 'devmachine doctor --machine main', href: `${base}reference/commands/#doctor` },
]

const description =
  'Devmachine for Mac: an optional macOS app for devmachine. Set up, open sessions, publish sites and check your machines from one window, on the same CLI and config.'

const site = Astro.site?.href ?? 'https://mydevmachine.sh/'
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Devmachine for Mac',
    description,
    url: `${site}app/`,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 14 or later',
    softwareVersion: '0.1.17',
    downloadUrl: dmg,
  },
]
---

<BaseLayout title="Devmachine for Mac — devmachine" description={description} current="docs" jsonLd={jsonLd}>
  <section class="frame pt-16 pb-12">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">macOS app · optional</p>
    <h1 class="text-4xl sm:text-6xl font-light tracking-tight mb-5">Devmachine for Mac.</h1>
    <p class="text-[var(--muted)] max-w-2xl">
      Do from one window what you would do with the devmachine CLI: set up machines, open sessions, add
      packages, publish sites, check health.
    </p>
    <p class="text-[var(--muted)] max-w-2xl mt-3">
      You do not need it. The app runs the same CLI on the same configuration folder, so anything you do in one
      shows up in the other. Start here or in the terminal, and switch any time.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] gap-10 items-start mt-10">
      <div class="border hairline p-4 sm:p-5">
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={dmg}
            class="inline-block border border-[var(--ink)] px-6 py-3 text-sm font-mono uppercase tracking-wide hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors"
          >
            Download for macOS
          </a>
          <span class="text-xs font-mono uppercase tracking-widest text-[var(--muted)]">macOS 14 Sonoma or later</span>
        </div>
        <p class="text-sm text-[var(--muted)] leading-relaxed mt-4">Or with Homebrew:</p>
        <div class="border hairline bg-[var(--card)] px-3 py-2 mt-2 flex items-center justify-between gap-2">
          <code class="font-mono text-xs min-w-0 break-all">{brew}</code>
          <button type="button" aria-label="Copy the Homebrew command" class="app-copy text-xs uppercase tracking-wide px-2 py-1 border hairline shrink-0" data-copy={brew}>
            Copy
          </button>
        </div>
        <p class="text-xs text-[var(--muted)] leading-relaxed mt-2">
          On Homebrew 7, trust the tap first:
          <code class="font-mono text-[var(--ink)]">brew trust mydevmachine/tap</code>.
        </p>
        <p class="text-sm text-[var(--muted)] leading-relaxed mt-4">
          Signed and notarized by Apple, so it opens without warnings. Not on the App Store.
          <a href="https://github.com/mydevmachine/app-releases/releases" class="underline underline-offset-2 hover:text-[var(--ink)] whitespace-nowrap">All releases →</a>
        </p>
        <div class="text-sm text-[var(--muted)] leading-relaxed mt-4 pt-4 border-t hairline space-y-1">
          <p>It uses:</p>
          <ul class="list-disc list-inside space-y-1">
            <li>The <code class="font-mono text-[var(--ink)]">devmachine</code> CLI on your Mac. No machine yet? The app's setup walks you through it.</li>
            <li>The <code class="font-mono text-[var(--ink)]">devmachine-app</code> package on a machine, for the context panel and stats.</li>
          </ul>
        </div>
      </div>
      <AppShot shot={heroShot} eager />
    </div>
  </section>

  <section id="do-it-from-the-app" class="frame pt-8 pb-12">
    <p class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-3">Do it from the app</p>
    <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-10">What you can do here.</h2>

    {
      sections.map((section, i) => {
        const [main, ...extra] = section.shots
        const flip = i % 2 === 1
        return (
          <article id={section.id} class="app-row grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-center py-12">
            <div class:list={[section.shots.length ? 'md:col-span-5' : 'md:col-span-7', flip && section.shots.length && 'md:order-2']}>
              <p class="text-xs font-mono text-[var(--muted)] mb-4">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="text-2xl sm:text-3xl font-light tracking-tight mb-3">{section.title}</h3>
              <p class="text-[var(--muted)] leading-relaxed">{section.body}</p>
              {section.prompts && (
                <ul class="mt-5 space-y-2">
                  {section.prompts.map((p) => (
                    <li class="border hairline bg-[var(--card)] px-3 py-2 font-mono text-xs break-words">
                      <span class="text-[var(--muted)]">&gt; </span>
                      {p}
                    </li>
                  ))}
                </ul>
              )}
              {section.id === 'operator' && (
                <p class="text-sm mt-4">
                  <a
                    href={`${base}day-to-day/#open-a-session-in-the-configuration-folder-to-change-devmachine-itself`}
                    class="underline underline-offset-2 text-[var(--muted)] hover:text-[var(--ink)]"
                  >
                    Why a session in the configuration folder →
                  </a>
                </p>
              )}
            </div>
            {section.shots.length > 0 && (<figure class:list={['md:col-span-7 min-w-0', flip && 'md:order-1']}>
              {section.shots.length === 2 ? (
                <div class="grid grid-cols-2 gap-4 items-start">
                  {section.shots.map((shot) => (
                    <div class="min-w-0">
                      <AppShot shot={shot} />
                      {shot.caption && <p class="text-sm text-[var(--muted)] mt-2">{shot.caption}</p>}
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <AppShot shot={main} />
                  {main.caption && <figcaption class="text-sm text-[var(--muted)] mt-2">{main.caption}</figcaption>}
                </>
              )}
              {extra.length > 1 && (
                <div class="grid grid-cols-2 gap-4 mt-6">
                  {extra.map((shot) => (
                    <div class="min-w-0">
                      <AppShot shot={shot} />
                      {shot.caption && <p class="text-sm text-[var(--muted)] mt-2">{shot.caption}</p>}
                    </div>
                  ))}
                </div>
              )}
            </figure>)}
          </article>
        )
      })
    }
  </section>

  <section class="frame pb-16">
    <h2 class="text-xs font-mono uppercase tracking-widest text-[var(--muted)] mb-4">In short</h2>
    <div class="grid-cards grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="pkg-card p-5">
            <h3 class="text-base mb-1">{f.title}</h3>
            <p class="text-sm text-[var(--muted)] leading-relaxed">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="also-a-cli-command" class="dark-section">
    <div class="frame py-20">
      <p class="text-xs font-mono uppercase tracking-widest text-[#9a9a9a] mb-3">Same tool underneath</p>
      <h2 class="text-3xl sm:text-4xl font-light tracking-tight mb-4">Everything here is also a CLI command.</h2>
      <p class="text-[#9a9a9a] max-w-2xl mb-10">
        The app works through the devmachine CLI. Prefer the terminal? Each of these has a command.
      </p>
      <div class="grid-cards grid-cols-1 md:grid-cols-2">
        {
          cliEquivalents.map((c) => (
            <a href={c.href} class="block p-5 hover:bg-white/5 min-w-0">
              <p class="text-sm text-[#9a9a9a] mb-2">{c.what}</p>
              <code class="font-mono text-sm break-words">{c.cmd}</code>
            </a>
          ))
        }
      </div>
      <p class="text-sm mt-6">
        <a href={`${base}reference/commands/`} class="underline underline-offset-2 text-[#9a9a9a] hover:text-white">
          Every command →
        </a>
      </p>
    </div>
  </section>

  <section class="frame pt-24 pb-32 text-center">
    <p class="text-[var(--muted)] max-w-xl mx-auto mb-6">
      Rather start in the terminal? The CLI is all you need. You can add the app later.
    </p>
    <a
      href={`${base}getting-started/`}
