---
interface Props {
  eyebrow: string
  headline: string
  subline: string
}

const { eyebrow, headline, subline } = Astro.props
const base = import.meta.env.BASE_URL
const restText = 'main · 2 workspaces, 1 agent at work'
---

<section class="mh-hero" id="hero" aria-labelledby="hero-title">
  <div class="frame mh-grid">
    <div class="mh-copy">
      <p class="mh-eyebrow">{eyebrow}</p>
      <h1 id="hero-title" class="mh-title">{headline}</h1>
      <p class="mh-sub">{subline}</p>
      <div class="mh-cta">
        <a class="mh-btn mh-btn-primary" href={`${base}#get-started`}>
          Get started
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"></path></svg>
        </a>
        <a class="mh-btn mh-btn-ghost" href={`${base}getting-started/`}>Documentation</a>
      </div>
    </div>

    <div class="mh-scene">
      <div id="ws-figure" data-rest={restText}></div>
      <button type="button" class="mh-motion" id="mh-motion" aria-pressed="false" aria-label="Pause animation" title="Pause animation">
        <svg class="mh-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14"></rect><rect x="14" y="5" width="4" height="14"></rect></svg>
        <svg class="mh-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      </button>
      <p class="mh-readout" aria-live="polite"><i aria-hidden="true"></i><span id="ws-read">{restText}</span></p>
    </div>
  </div>
</section>

<script>
  import { HL } from '../lib/hairline.js'

  const {
    Cam, circ, facing, fit, open, poly, proj, prism, put, rings, rrect, solid,
    spring, stepS, unproj, disposer, mk, place, pointer, register,
  } = HL

  const NODES = [
    { id: 'phone', x: -78, y: -22, s: 15, mark: 'phone', name: 'your phone' },
    { id: 'domain', x: 6, y: -96, s: 15, mark: 'globe', name: 'acme.example.com' },
    { id: 'laptop', x: -54, y: 58, s: 15, mark: 'laptop', name: 'you@laptop' },
    { id: 'main', x: 0, y: 0, s: 22, mark: 'prompt', name: 'main · your server' },
    { id: 'acme', x: 66, y: -54, s: 15, mark: 'window', name: 'acme · workspace' },
    { id: 'globex', x: 44, y: 66, s: 15, mark: 'window', name: 'globex · workspace' },
    { id: 'claude', x: 104, y: 8, s: 15, mark: 'agent', name: 'claude · at work in acme' },
  ]
  const EDGES = [
    ['laptop', 'main', 2.6, 0], ['phone', 'main', 3.1, 0.4], ['main', 'acme', 2.4, 0.2],
    ['acme', 'claude', 2.0, 0.6], ['main', 'globex', 2.9, 0.75], ['acme', 'domain', 2.7, 0.1],
  ]
  const BASE = 8, TIER = 6, LIFT = 7

  const MARKS = {
    prompt: [[[-4.5, -5], [0.5, 0], [-4.5, 5]], [[2.5, 4], [7.5, 4]]],
    laptop: [rrect(-5, -4, 5, 2, 1, 2).map((q) => [q.u, q.v]).concat([[-5, -4]]), [[-6.5, 4], [6.5, 4]]],
    phone: [rrect(-3.2, -5.5, 3.2, 5.5, 1.4, 2).map((q) => [q.u, q.v]).concat([[-3.2, -3]]), [[-1, 3.8], [1, 3.8]]],
    window: [rrect(-6, -4.5, 6, 4.5, 1.2, 2).map((q) => [q.u, q.v]).concat([[-6, -2]]), [[-6, -1.8], [6, -1.8]], [[-4, 1.2], [2, 1.2]]],
    agent: [0, 45, 90, 135].map((a) => {
      const r = (a * Math.PI) / 180
      return [[-5 * Math.cos(r), -5 * Math.sin(r)], [5 * Math.cos(r), 5 * Math.sin(r)]]
    }),
    globe: [circ(5, 16).map((q) => [q.u, q.v]), circ(5, 16).map((q) => [q.u * 0.42, q.v]), [[-5, 0], [5, 0]]],
  }

  function mount({ stage, svg, read }, value) {
    const bag = disposer()
    let speed = value, clock = 0
    const nodes = NODES.map((n) => ({ ...n }))
    const by = Object.fromEntries(nodes.map((n) => [n.id, n]))

    const C = Cam(45, 0.5, 1.72)
    const ext = nodes.flatMap((n) => [[n.x - n.s, n.y - n.s, 0], [n.x + n.s, n.y + n.s, 0], [n.x - n.s, n.y - n.s, BASE + TIER + LIFT]])
    fit(C, ext, 200, 168)
    const P = proj(C), front = facing(C)
    const g = mk('g', {}, svg)

    const routes = EDGES.map(([a, b, dur, ph]) => {
      const A = by[a], Bn = by[b], pts = [[A.x, A.y], [A.x, Bn.y], [Bn.x, Bn.y]]
      const lens = [Math.abs(Bn.y - A.y), Math.abs(Bn.x - A.x)], total = lens[0] + lens[1]
      mk('path', { d: open(pts.map(([x, y]) => P(x, y, 0))), class: 'nf lo trace' }, g)
      return { a, b, pts, lens, total, dur, ph, last: ph }
    })

    const ux = P(1, 0, 0), uy = P(0, 1, 0), o = P(0, 0, 0)
    const onGround = (x, y, txt, cls) => {
      const at = P(x, y, 0)
      const t = mk('text', { class: cls, transform: `matrix(${ux[0] - o[0]},${ux[1] - o[1]},${uy[0] - o[0]},${uy[1] - o[1]},${at[0]},${at[1]})` }, g)
      t.textContent = txt
    }
    onGround(-54, 22, 'ssh', 'board-tag')
    onGround(66, -82, 'https', 'board-tag')

    const packets = routes.map(() => mk('circle', { r: 2.3, class: 'dot packet' }, g))

    const order = nodes.slice().sort((p, q) => p.x + p.y - (q.x + q.y))
    for (const n of order) {
      n.g = mk('g', {}, g)
      n.base = solid(n.g)
      n.tier = solid(n.g)
      n.coin = mk('path', { class: 'coin' }, n.g)
      n.markEl = mk('path', { class: 'nf mark' + (n.id === 'main' ? ' brand' : '') }, n.g)
      n.lift = spring(0)
      n.flash = 0
      n.drawn = NaN
    }

    function draw(n) {
      const z = n.lift.x, s = n.s, top = BASE + TIER + z, k = s / 15
      const [r0, r0i] = rings(n.x - s, n.y - s, n.x + s, n.y + s, 6 * k, 1.6)
      const [r1, r1i] = rings(n.x - s + 4, n.y - s + 4, n.x + s - 4, n.y + s - 4, 4.5 * k, 1.4)
      put(n.base, prism(P, front, r0, r0i, z, BASE + z))
      put(n.tier, prism(P, front, r1, r1i, BASE + z, top))
      n.coin.setAttribute('d', poly(circ(8.2 * k, 24).map((q) => P(n.x + q.u, n.y + q.v, top + 0.2))))
      const sc = 0.95 * k
      n.markEl.setAttribute('d', MARKS[n.mark].map((line) => open(line.map(([u, v]) => P(n.x + u * sc, n.y + v * sc, top + 0.3)))).join(''))
      n.drawn = z
    }

    let hover = null, paused = false
    const B = register(stage, (dt) => {
      if (!paused) clock += dt * speed
      routes.forEach((rt, i) => {
        const f = (clock / rt.dur + rt.ph) % 1
        if (f < rt.last) by[rt.b].flash = 0.5
        rt.last = f
        const d = f * rt.total
        const p = d <= rt.lens[0]
          ? [rt.pts[0][0], rt.pts[0][1] + Math.sign(rt.pts[1][1] - rt.pts[0][1]) * d]
          : [rt.pts[1][0] + Math.sign(rt.pts[2][0] - rt.pts[1][0]) * (d - rt.lens[0]), rt.pts[1][1]]
        place(packets[i], P(p[0], p[1], 0))
      })
      for (const n of nodes) {
        stepS(n.lift, dt)
        if (n.lift.x !== n.drawn) draw(n)
        n.flash = Math.max(0, n.flash - dt)
        n.tier.sil.classList.toggle('hi', n.flash > 0 || n === hover)
      }
      return !paused || nodes.some((n) => n.lift.x !== n.lift.t || n.flash > 0)
    })
    bag.add(B.unregister)
    nodes.forEach(draw)

    function move([sx, sy]) {
      const [x, y] = unproj(C, sx, sy, 0)
      let pick = null
      for (const n of nodes) if (Math.abs(x - n.x) <= n.s + 4 && Math.abs(y - n.y) <= n.s + 4) pick = n
      if (pick === hover) return
      if (hover) hover.lift.t = 0
      hover = pick
      if (hover) hover.lift.t = LIFT
      read(hover ? hover.name : null)
      B.wake()
    }
    const leave = () => {
      if (hover) hover.lift.t = 0
      hover = null
      read(null)
      B.wake()
    }
    bag.add(pointer(stage, { move, leave }))
    bag.add(() => svg.replaceChildren())
    return {
      setPaused: (p) => {
        paused = p
        B.wake()
      },
      destroy: bag.dispose,
    }
  }

  const stage = document.getElementById('ws-figure')
  const out = document.getElementById('ws-read')
  const button = document.getElementById('mh-motion')
  if (stage && out && button) {
    HL.inject(document)
    const restText = stage.dataset.rest ?? ''
    stage.setAttribute('data-hairline', 'mesh')
    stage.setAttribute('role', 'img')
    stage.setAttribute('aria-label', 'Your machine in the middle of everything you code from, with work moving between them all the time.')
    const svg = HL.mk('svg', { viewBox: '0 0 400 320', 'aria-hidden': 'true' }, stage)
    const figure = mount({ stage, svg, read: (text) => { out.textContent = text ?? restText } }, 1)

    const setPaused = (p) => {
      const label = p ? 'Play animation' : 'Pause animation'
      button.setAttribute('aria-pressed', String(p))
      button.setAttribute('aria-label', label)
      button.title = label
      figure.setPaused(p)
    }
    button.addEventListener('click', () => setPaused(button.getAttribute('aria-pressed') !== 'true'))
    const reduce = matchMedia('(prefers-reduced-motion: reduce)')
    if (reduce.matches) setPaused(true)
    reduce.addEventListener('change', (e) => setPaused(e.matches))
  }
</script>

<style is:global>
  .mh-hero {
    --mh-grid-line: rgb(15 20 26 / 0.07);
    --mh-trace: #c4c5c0;
    --mh-coin: #0f141a;
    --mh-mark: #f5f5f2;
    --mh-tag: #8a8d94;
    --mh-readout: #3a3f47;
    --mh-primary-hover: #262c34;
    --hairline-plate: var(--bg);
    --hairline-hi: #0f141a;
    --hairline-edge: #3d424a;
    --hairline-mid: #8a8d94;
    --hairline-lo: #d3d3cf;
    --hairline-stroke: 0.9;
    --mh-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(100svh, 860px);
    display: flex;
    align-items: center;
    padding: 112px 0 72px;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  :root[data-theme='dark'] .mh-hero {
    --mh-grid-line: rgb(255 255 255 / 0.07);
    --mh-trace: #34353a;
    --mh-coin: #f5f5f2;
    --mh-mark: #050505;
    --mh-tag: #8a8d94;
    --mh-readout: #c9cbd0;
    --mh-primary-hover: #d9d9d4;
    --hairline-hi: #f5f5f2;
    --hairline-edge: #a4a6ad;
    --hairline-mid: #5b5d64;
    --hairline-lo: #2c2d31;
  }

  .mh-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-linear-gradient(150deg, var(--mh-grid-line) 0 1px, transparent 1px 36px),
      repeating-linear-gradient(30deg, var(--mh-grid-line) 0 1px, transparent 1px 36px);
    -webkit-mask-image: radial-gradient(60% 75% at 72% 50%, #000 0%, rgb(0 0 0 / 0.35) 55%, transparent 85%);
    mask-image: radial-gradient(60% 75% at 72% 50%, #000 0%, rgb(0 0 0 / 0.35) 55%, transparent 85%);
  }

  .mh-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: 24px;
  }

  .mh-copy {
    max-width: 520px;
  }

  .mh-eyebrow {
    margin: 0 0 20px;
    font-family: var(--mh-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mh-title {
    margin: 0;
    font-size: clamp(52px, 6.6vw, 92px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .mh-sub {
    margin: 26px 0 0;
    max-width: 31ch;
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .mh-cta {
    display: flex;
    gap: 10px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .mh-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 20px;
    border: 1px solid var(--ink);
    font-family: var(--mh-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }

  .mh-btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.15s;
  }

  .mh-btn:hover svg {
    transform: translateX(2px);
  }

  .mh-btn-primary {
    background: var(--ink);
    color: var(--bg);
  }

  .mh-btn-primary:hover {
    background: var(--mh-primary-hover);
  }

  .mh-btn-ghost {
    background: var(--card);
    border-color: var(--line);
  }

  .mh-btn-ghost:hover {
    border-color: var(--ink);
  }

  .mh-scene {
    position: relative;
    width: calc(100% + 64px);
    margin-right: -64px;
  }

  #ws-figure {
    width: 100%;
  }

  #ws-figure svg .trace {
    stroke: var(--mh-trace);
  }

  #ws-figure svg .packet {
    fill: var(--ink);
  }

  #ws-figure svg .coin {
    fill: var(--mh-coin);
    stroke: var(--mh-coin);
  }

  #ws-figure svg .mark {
    stroke: var(--mh-mark);
    stroke-width: 1.15;
  }

  #ws-figure svg .mark.brand {
    stroke: #28c840;
    stroke-width: 1.5;
  }

  #ws-figure svg .board-tag {
    font-family: var(--mh-mono);
    font-size: 7px;
    fill: var(--mh-tag);
    stroke: none;
    letter-spacing: 0.06em;
  }

  .mh-readout {
    position: absolute;
    left: 4%;
    top: 6%;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 11px;
    background: var(--card);
    border: 1px solid var(--line);
    font-family: var(--mh-mono);
    font-size: 12px;
    color: var(--mh-readout);
    box-shadow: 0 1px 2px rgb(15 20 26 / 0.06);
  }

  .mh-readout i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #23a03c;
  }

  .mh-motion {
    position: absolute;
    right: 64px;
    bottom: 6%;
    z-index: 3;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
  }

  .mh-motion svg {
    width: 11px;
    height: 11px;
  }

  .mh-motion .mh-play {
    display: none;
  }

  .mh-motion[aria-pressed='true'] .mh-play {
    display: block;
  }

  .mh-motion[aria-pressed='true'] .mh-pause {
    display: none;
  }

  @media (max-width: 980px) {
    .mh-scene {
      width: 100%;
      margin-right: 0;
    }

    .mh-motion {
      right: 0;
    }

    .mh-hero {
      min-height: 0;
      padding-top: 120px;
    }

    .mh-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .mh-copy {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .mh-sub {
      font-size: 17px;
    }

    .mh-btn {
      flex: 1;
      justify-content: center;
    }

    .mh-readout {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mh-btn svg {
      transition: none;
    }
  }
</style>
