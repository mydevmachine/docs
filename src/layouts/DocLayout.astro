---
import BaseLayout from './BaseLayout.astro'
import SidebarNav from '../components/SidebarNav.astro'
import GuideCard from '../components/GuideCard.astro'
import GuideIcon from '../components/GuideIcon.astro'
import { getNavGroups, getPrevNext, urlFor, markdownUrlFor, type DocEntry } from '../lib/nav'
import { categorySlug, getRelatedGuides, isGuide } from '../lib/guides'
const base = import.meta.env.BASE_URL

interface Props {
  entry: DocEntry
  headings: { depth: number; slug: string; text: string }[]
}

const { entry, headings } = Astro.props
const groups = await getNavGroups()
const { prev, next } = await getPrevNext(entry.id)
const currentUrl = urlFor(entry)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const editUrl = `https://github.com/mydevmachine/devmachine/blob/main/${entry.data.sourcePath}`
const guide = isGuide(entry)
const { category, level, needs } = entry.data
const related = guide ? await getRelatedGuides(entry) : []
const guidesUrl = new URL('/guides/', Astro.site).href
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.summary,
    url: new URL(currentUrl, Astro.site).href,
    isPartOf: { '@type': 'WebSite', name: 'devmachine', url: Astro.site?.href },
    about: { '@type': 'SoftwareApplication', name: 'devmachine' },
    ...(guide && category ? { articleSection: category } : {}),
    ...(guide && level ? { proficiencyLevel: level } : {}),
  },
]
if (guide) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: guidesUrl },
      { '@type': 'ListItem', position: 2, name: entry.data.title, item: new URL(currentUrl, Astro.site).href },
    ],
  })
}
---

<BaseLayout
  title={`${entry.data.title} — devmachine ${guide ? 'guides' : 'docs'}`}
  description={entry.data.summary}
  current="docs"
  markdownUrl={markdownUrlFor(entry)}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="frame lg:grid lg:grid-cols-[220px_minmax(0,1fr)_200px] lg:gap-10">
    <div class="hidden lg:block py-10">
      <div class="sticky top-24">
        <SidebarNav groups={groups} currentUrl={currentUrl} />
      </div>
    </div>

    <button
      id="sidebar-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-sidebar"
      class="lg:hidden mt-4 text-xs font-mono uppercase tracking-wide px-3 py-1.5 border hairline"
    >
      Browse docs
    </button>
    <div id="mobile-sidebar" class="hidden lg:hidden py-4 border-b hairline mb-4">
      <SidebarNav groups={groups} currentUrl={currentUrl} />
    </div>

    <article class="py-10 min-w-0">
      <div id="search" class="mb-8"></div>
      {
        guide ? (
          <nav aria-label="Breadcrumb" class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mb-2">
            <a href="/guides/" class="hover:text-[var(--ink)]">Guides</a>
            {category && (
              <>
                <span aria-hidden="true"> / </span>
                <a href={`/guides/#${categorySlug(category)}`} class="hover:text-[var(--ink)]">{category}</a>
              </>
            )}
          </nav>
        ) : (
          <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mb-2">{entry.data.section}</p>
        )
      }
      <h1 class="text-3xl sm:text-4xl font-light tracking-tight mb-6" style="letter-spacing: -0.03em;">
        {entry.data.title}
      </h1>
      {
        guide && (level || needs.length > 0) && (
          <div class="guide-meta max-w-[72ch] mb-8 border hairline bg-[var(--card)] p-4 flex flex-col sm:flex-row gap-4">
            <span class="guide-icon hidden sm:inline-flex items-center justify-center w-12 h-12 shrink-0">
              <GuideIcon category={category ?? null} size={24} />
            </span>
            <dl class="grid gap-3 text-sm min-w-0">
              {level && (
                <div class="flex flex-wrap items-center gap-2">
                  <dt class="sr-only">Level</dt>
                  {level && <dd class="guide-chip font-mono text-xs">{level}</dd>}
                </div>
              )}
              {needs.length > 0 && (
                <div class="flex flex-wrap items-center gap-2">
                  <dt class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mr-1">What you need</dt>
                  {needs.map((need) => (
                    <dd class="guide-chip text-xs">{need}</dd>
                  ))}
                </div>
              )}
            </dl>
          </div>
        )
      }
      <div class="prose-doc max-w-[72ch]">
        <slot />
      </div>

      {
        related.length > 0 && (
          <section aria-labelledby="next-guides" class="mt-12">
            <h2 id="next-guides" class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mb-3">Where to go next</h2>
            <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {related.map((g) => (
                <li>
                  <GuideCard guide={g} headingLevel="h3" />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-12 pt-6 border-t hairline flex flex-wrap items-center justify-between gap-4 text-sm">
        <a href={editUrl} target="_blank" rel="noreferrer" class="text-[var(--muted)] hover:text-[var(--ink)]">
          Edit this page on GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>

      <nav aria-label="Previous and next page" class="mt-6 grid sm:grid-cols-2 gap-4">
        {
          prev && (
            <a href={prev.url} class="block border hairline p-4 hover:border-[var(--ink)]">
              <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)]">Previous</p>
              <p class="font-medium mt-1">{prev.title}</p>
            </a>
          )
        }
        {
          next && (
            <a href={next.url} class="block border hairline p-4 text-right hover:border-[var(--ink)] sm:col-start-2">
              <p class="text-xs font-mono uppercase tracking-wide text-[var(--muted)]">Next</p>
              <p class="font-medium mt-1">{next.title}</p>
            </a>
          )
        }
      </nav>
    </article>

    <div class="hidden lg:block py-10">
      <div class="sticky top-24">
        {
          toc.length > 0 && (
            <nav aria-labelledby="toc-title">
              <p id="toc-title" class="text-xs font-mono uppercase tracking-wide text-[var(--muted)] mb-3">On this page</p>
              <ul class="space-y-2 text-sm">
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && 'pl-3']}>
                    <a href={`#${h.slug}`} class="text-[var(--muted)] hover:text-[var(--ink)]">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>
  </div>

  <script is:inline>
    for (const group of document.querySelectorAll('.doc-tabs')) {
      const tabs = Array.from(group.querySelectorAll('[role="tab"]'))
      const select = (tab, focus) => {
        for (const t of tabs) {
          const selected = t === tab
          t.setAttribute('aria-selected', String(selected))
          t.tabIndex = selected ? 0 : -1
          const panel = document.getElementById(t.getAttribute('aria-controls'))
          panel?.toggleAttribute('data-inactive', !selected)
          if (panel) panel.tabIndex = selected ? 0 : -1
        }
        if (focus) tab.focus()
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab, false))
        tab.addEventListener('keydown', (e) => {
          const next = {
            ArrowRight: tabs[(i + 1) % tabs.length],
            ArrowLeft: tabs[(i - 1 + tabs.length) % tabs.length],
            Home: tabs[0],
            End: tabs[tabs.length - 1],
          }[e.key]
          if (!next) return
          e.preventDefault()
          select(next, true)
        })
      })
    }
  </script>

  <script is:inline>
    const sidebarToggle = document.getElementById('sidebar-toggle')
    const mobileSidebar = document.getElementById('mobile-sidebar')
    sidebarToggle?.addEventListener('click', () => {
      const open = mobileSidebar?.classList.toggle('hidden') === false
      sidebarToggle.setAttribute('aria-expanded', String(open))
    })
  </script>

  <link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} onerror="this.remove()" />
  <script type="module" define:vars={{ base }}>
    try {
      const mod = await import(/* @vite-ignore */ `${base}pagefind/pagefind-ui.js`)
      const PagefindUI = mod.PagefindUI ?? window.PagefindUI
      if (PagefindUI) {
        new PagefindUI({ element: '#search', showSubResults: true, showImages: false })
        const labelSearch = () => {
          const input = document.querySelector('#search input')
          if (!input) return false
          input.setAttribute('aria-label', 'Search the documentation')
          return true
        }
        if (!labelSearch()) {
          const observer = new MutationObserver(() => {
            if (labelSearch()) observer.disconnect()
          })
          observer.observe(document.getElementById('search'), { childList: true, subtree: true })
        }
      }
    } catch {
      // Pagefind assets only exist in a production build (npm run build), not in dev.
    }
  </script>
</BaseLayout>
