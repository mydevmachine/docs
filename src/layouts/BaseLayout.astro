---
import '../styles/global.css'
import cli from '../data/cli.json'
import packagesData from '../data/packages.json'

interface Props {
  title: string
  description?: string
  current?: 'home' | 'docs'
  markdownUrl?: string
  ogType?: 'website' | 'article'
  jsonLd?: Record<string, unknown>[]
  noindex?: boolean
}

const {
  title,
  description = 'Documentation for the devmachine CLI.',
  current = 'home',
  markdownUrl,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(`${base}og.png`, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="devmachine" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="devmachine — Code from anywhere." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(() => {
        let saved = null
        try {
          saved = localStorage.getItem('devmachine-theme')
        } catch {}
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved)
          return
        }
        const system = window.matchMedia('(prefers-color-scheme: dark)')
        const follow = () => document.documentElement.setAttribute('data-theme', system.matches ? 'dark' : 'light')
        follow()
        system.addEventListener('change', () => {
          let chosen = null
          try {
            chosen = localStorage.getItem('devmachine-theme')
          } catch {}
          if (!chosen) follow()
        })
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <header
      class:list={[
        'z-40',
        current === 'home' ? 'absolute top-0 inset-x-0 bg-transparent' : 'border-b hairline sticky top-0 bg-[var(--bg)]',
      ]}
    >
      <div class="frame h-16 flex items-center justify-between">
        <a href={`${base}`} class="flex items-center gap-1.5 font-semibold tracking-tight text-[28px] leading-none">
          <img src={`${base}favicon.svg`} alt="" width="36" height="36" class="block" />
          devmachine
        </a>
        <div class="flex items-center gap-2">
          <nav aria-label="Main" class="hidden md:flex items-center gap-1 text-sm">
            <a href={`${base}#get-started`} class="px-3 py-1.5">Getting started</a>
            <a href={`${base}getting-started/`} class="px-3 py-1.5">Documentation</a>
            <a href={`${base}guides/`} class="px-3 py-1.5">Guides</a>
            <a href={`${base}packages/`} class="px-3 py-1.5">Packages</a>
            <a href={`${base}app/`} class="px-3 py-1.5">App</a>
          </nav>
          <button
            id="mobile-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            class="md:hidden text-xs font-mono uppercase tracking-wide px-3 py-1.5 border hairline"
          >
            Menu
          </button>
        </div>
      </div>
      <nav id="mobile-nav" aria-label="Main" class="hidden md:hidden border-t hairline px-4 py-3 flex flex-col gap-2 text-sm bg-[var(--bg)]">
        <a href={`${base}#get-started`}>Getting started</a>
        <a href={`${base}getting-started/`}>Documentation</a>
        <a href={`${base}guides/`}>Guides</a>
        <a href={`${base}packages/`}>Packages</a>
        <a href={`${base}app/`}>App</a>
      </nav>
    </header>
    <main id="main" tabindex="-1" class="flex-1 min-w-0 focus:outline-none">
      <slot />
    </main>
    <footer class="border-t hairline mt-12">
      <div class="frame py-8 flex items-start justify-between gap-4">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-[var(--muted)] min-w-0">
          <a href={`${base}getting-started/`}>Documentation</a>
          <a href={`${base}packages/`}>Packages</a>
          <a href={`${base}app/`}>App</a>
          <a href={`${base}guides/`}>Guides</a>
          <a href="https://github.com/mydevmachine/devmachine" target="_blank" rel="noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
          <a href="https://github.com/mydevmachine/devmachine/blob/main/LICENSE" target="_blank" rel="noreferrer">License<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={`${base}llms.txt`}>llms.txt</a>
          <a href={`${base}llms-full.txt`}>llms-full.txt</a>
          {
            cli.version && (
              <a
                href={`https://github.com/mydevmachine/devmachine/releases/tag/${cli.version}`}
                target="_blank"
                rel="noreferrer"
                class="font-mono"
              >
                CLI {cli.version}<span class="sr-only"> release notes (opens in a new tab)</span>
              </a>
            )
          }
          {
            packagesData.release && (
              <a
                href={`https://github.com/mydevmachine/packages/releases/tag/${packagesData.release}`}
                target="_blank"
                rel="noreferrer"
                class="font-mono"
              >
                packages {packagesData.release}<span class="sr-only"> release notes (opens in a new tab)</span>
              </a>
            )
          }
        </nav>
        <button
          id="theme-toggle"
          type="button"
          class="theme-toggle inline-flex items-center justify-center w-8 h-8 border hairline shrink-0"
          aria-label="Dark theme"
          aria-pressed="false"
          title="Light / dark"
        >
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </footer>
    <div id="live-status" class="sr-only" role="status" aria-live="polite"></div>
    <script is:inline>
      const liveStatus = document.getElementById('live-status')
      window.announce = (message) => {
        if (!liveStatus) return
        liveStatus.textContent = ''
        setTimeout(() => {
          liveStatus.textContent = message
        }, 50)
      }

      window.copyWithFeedback = (btn, text) => {
        const original = btn.textContent
        const done = (ok) => {
          btn.textContent = ok ? 'Copied' : 'Copy failed'
          window.announce(ok ? 'Copied to the clipboard' : 'Could not copy to the clipboard')
          setTimeout(() => {
            btn.textContent = original
          }, 1500)
        }
        if (!navigator.clipboard) return done(false)
        navigator.clipboard.writeText(text).then(
          () => done(true),
          () => done(false),
        )
      }

      const root = document.documentElement
      const themeToggle = document.getElementById('theme-toggle')
      const syncThemeToggle = () => {
        themeToggle?.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'))
      }
      syncThemeToggle()
      new MutationObserver(syncThemeToggle).observe(root, { attributes: true, attributeFilter: ['data-theme'] })
      themeToggle?.addEventListener('click', () => {
        const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
        const next = current === 'dark' ? 'light' : 'dark'
        root.setAttribute('data-theme', next)
        try {
          localStorage.setItem('devmachine-theme', next)
        } catch {}
      })

      const mobileToggle = document.getElementById('mobile-nav-toggle')
      const mobileNav = document.getElementById('mobile-nav')
      mobileToggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('hidden') === false
        mobileToggle.setAttribute('aria-expanded', String(open))
      })
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || mobileToggle?.getAttribute('aria-expanded') !== 'true') return
        mobileNav?.classList.add('hidden')
        mobileToggle.setAttribute('aria-expanded', 'false')
        mobileToggle.focus()
      })

      const markScrollable = (el, label) => {
        const update = () => {
          const scrollable = el.scrollWidth > el.clientWidth + 1
          if (scrollable) {
            el.setAttribute('tabindex', '0')
            el.setAttribute('role', 'group')
            el.setAttribute('aria-label', label)
          } else {
            el.removeAttribute('tabindex')
            el.removeAttribute('role')
            el.removeAttribute('aria-label')
          }
        }
        update()
        new ResizeObserver(update).observe(el)
      }
      document.querySelectorAll('.prose-doc table').forEach((table) => markScrollable(table, 'Table, scrolls sideways'))

      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.querySelector('.copy-btn')) return

        const scrollWrap = document.createElement('div')
        scrollWrap.className = 'pre-scroll'
        while (pre.firstChild) scrollWrap.appendChild(pre.firstChild)
        pre.appendChild(scrollWrap)

        const btn = document.createElement('button')
        btn.className = 'copy-btn'
        btn.type = 'button'
        btn.textContent = 'Copy'
        btn.setAttribute('aria-label', 'Copy code')
        btn.addEventListener('click', () => {
          const code = scrollWrap.querySelector('code')?.textContent ?? scrollWrap.textContent ?? ''
          window.copyWithFeedback(btn, code.trim())
        })
        pre.appendChild(btn)
        pre.removeAttribute('tabindex')
        markScrollable(scrollWrap, 'Code, scrolls sideways')
      })
    </script>
  </body>
</html>
